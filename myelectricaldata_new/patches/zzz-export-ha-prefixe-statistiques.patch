 SOFTWARE_VERSION = "1.8.0"
 
 
+def statistic_prefix(config: dict[str, Any] | None) -> str:
+    """Préfixe des statistiques HA nettoyé : sans espaces autour, minuscules, caractères invalides en « _ »
+
+    Un identifiant de statistique n'accepte que [a-z0-9_] avant les deux-points : une espace finale
+    (« myelectricaldata  ») faisait échouer tout l'import (Invalid statistic_id, issue hassio-addons#48).
+    """
+    raw = str((config or {}).get("statistic_id_prefix") or "").strip().lower()
+    cleaned = re.sub(r"_+", "_", re.sub(r"[^a-z0-9_]", "_", raw)).strip("_")
+    return cleaned or "myelectricaldata"
+
+
 def _ha_version_at_least(version: str | None, major: int, minor: int) -> bool:
     """Vrai si la version de Home Assistant est >= major.minor (version inconnue : vrai)."""
     parts = str(version or "").split(".")
@@ -3565,7 +3576,7 @@ class HomeAssistantExporter(BaseExporter):
